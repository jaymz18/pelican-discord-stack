            "script": "#!/bin/bash\n# Pelican Installationsskript – klont Bot und Website aus dem GitHub-Repository\nset -e\napt-get update -qq\napt-get install -y -qq --no-install-recommends git ca-certificates > /dev/null\n\nmkdir -p /mnt/server\ncd /mnt/server\n\nGIT_BRANCH=${GIT_BRANCH:-main}\n\necho \"Klone ${GIT_REPO} (Branch: ${GIT_BRANCH}) ...\"\nrm -rf /tmp/src\ngit clone --depth 1 --branch \"${GIT_BRANCH}\" \"${GIT_REPO}\" /tmp/src\n\nfor dir in bot website; do\n    if [ ! -d \"/tmp/src/${dir}\" ]; then\n        echo \"FEHLER: Ordner '${dir}' existiert nicht im Repository.\"\n        exit 1\n    fi\n    mkdir -p \"/mnt/server/${dir}\"\n    cp -r \"/tmp/src/${dir}/.\" \"/mnt/server/${dir}/\"\n    echo \"-> ${dir}/ installiert\"\ndone\n\nrm -rf /tmp/src\necho \"Installation abgeschlossen. Bot-Token und Datenbank unter 'Startup' eintragen.\"\n",
